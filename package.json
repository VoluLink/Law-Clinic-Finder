{
  "name": "law-clinic-finder",
  "version": "0.1.0-alpha.1",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:login:teardown": "node --env-file=.env.local scripts/dev-login.mjs --teardown",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:firebase": "firebase emulators:exec --project law-clinic-finder --only firestore \"vitest run src/lib/firebase/transactions.integration.test.ts src/lib/firebase/durable-limit-store.integration.test.ts\"",
    "test:rules": "firebase emulators:exec --project demo-law-clinic-finder --only firestore,storage \"vitest run src/lib/firebase/security-rules.test.ts\"",
    "test:e2e": "node scripts/e2e/run-local.mjs",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project law-clinic-finder --only auth,firestore,functions,storage",
    "import:clinics": "node --env-file=.env.local --import tsx scripts/import-clinics.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chat:guidance": "node --env-file=.env.local --import tsx scripts/update-chat-guidance.ts",
    "dlp:check": "REDACTION_PROVIDER=dlp tsx scripts/check-dlp.ts",
    "pdf:fonts": "tsx scripts/generate-pdf-fonts.ts",
    "branding:fonts": "tsx scripts/generate-branding-fonts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.2",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google-cloud/firestore": "^8.7.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.27.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
