# Supabase — from your project's API settings (safe to expose: anon key is public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Dev-only: enables the no-email test logins on /login. NEVER set in production.
DEV_LOGIN_ENABLED=
