# Supabase source — needed only while running the copy/verification CLI. The
# application does not use these values at runtime. Keep the source intact.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never commit real values
ANTHROPIC_API_KEY=

# Firebase target — the project ID is intentionally pinned so a migration or
# deployment cannot silently write to another Google Cloud project. App Hosting
# supplies Application Default Credentials; local development uses the Emulator
# Suite or GOOGLE_APPLICATION_CREDENTIALS outside this file.
FIREBASE_PROJECT_ID=law-clinic-finder
FIREBASE_DATABASE_ID=primary-eu
FIREBASE_STORAGE_BUCKET=law-clinic-finder.firebasestorage.app
IDENTITY_PLATFORM_API_KEY=

# Provider-neutral SMTP configuration. Brevo is the initial provider, but no
# provider-specific API is used. Port 465 uses implicit TLS; all other ports
# require STARTTLS. Keep the password server-only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Law Clinics Deutschland

# Admin-managed SMTP configuration. The complete settings payload lives as one
# versioned Secret Manager secret that the admin screen writes and the runtime
# reads; the SMTP_* variables above stay as the fallback until the first version
# is activated. Leave the location empty for a global secret.
SMTP_SETTINGS_SECRET=smtpSettings
SMTP_SETTINGS_SECRET_LOCATION=

# Public base URL of this deployment — used to build the /auth/confirm link in
# auth emails. PLACEHOLDER: replace before going live. During migration it must
# remain reachable for sent links; Firebase requires the hostname in
# Authentication > Settings > Authorized domains.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example

# Temporary App Hosting staging gate. Leave disabled for local development and
# remove all three variables when the public launch is approved. When enabled,
# use a unique 20+ character printable ASCII password stored only as a secret.
STAGING_ACCESS_ENABLED=false
STAGING_ACCESS_USERNAME=preview
STAGING_ACCESS_PASSWORD=

# Dev-only: enables the no-email test logins on /login. NEVER set in production.
DEV_LOGIN_ENABLED=

# Google Analytics 4 (optional). Two different identifiers are involved:
#   NEXT_PUBLIC_GA_MEASUREMENT_ID — the public "G-XXXXXXXXXX" measurement id of
#     the web data stream. Client-side only; enables consent-gated tracking.
#   GA_PROPERTY_ID — the numeric property id (Admin > Property > Details, e.g.
#     412345678). NOT the G- id. The Data API addresses this one.
# The dashboard's GA cards (Nutzer/Sitzungen/Engagement) stay empty until both
# GA_PROPERTY_ID and GA_SERVICE_ACCOUNT_JSON are set; see
# src/lib/analytics/ga-metrics.ts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
# Server-only service account key as one JSON string (single line, \n escapes
# intact). The account needs the "Viewer" role on that GA4 property. Never
# prefix with NEXT_PUBLIC_ and never commit a real key — in production it lives
# in Secret Manager as `gaServiceAccountJson` (see apphosting.yaml).
GA_SERVICE_ACCOUNT_JSON=

# Abuse challenge for the first message of a chat. Off unless CHALLENGE_ENABLED
# is exactly "true", so local runs, tests and the emulator are never gated.
# Provider "pow" (default) is a self-hosted proof of work: no third party, no
# cookie, nothing to provision. "turnstile" switches to Cloudflare Turnstile once
# the site sits behind Cloudflare — it also needs TURNSTILE_SECRET and a client
# widget, and belongs in the Datenschutzerklärung as a processor.
# The NEXT_PUBLIC_ pair only tells the browser whether to do the work; the server
# is the authority. Keep them in step with the server values.
CHALLENGE_ENABLED=false
CHALLENGE_PROVIDER=pow
CHALLENGE_POW_DIFFICULTY=16
TURNSTILE_SECRET=
NEXT_PUBLIC_CHALLENGE_PROVIDER=
NEXT_PUBLIC_CHALLENGE_POW_DIFFICULTY=16

# Which header carries the real client address. Unset = Google App Hosting's
# X-Forwarded-For chain. Set to "cloudflare" ONLY once the origin is locked down
# to Cloudflare ranges — otherwise CF-Connecting-IP can be forged by anyone
# reaching Cloud Run directly, and every per-IP limit becomes meaningless.
TRUSTED_PROXY=

# Lowest log level persisted to Firestore for /admin/logs. Default "warn".
LOG_PERSIST_LEVEL=
