# Supabase source — needed only while running the copy/verification CLI. The
# application does not use these values at runtime. Keep the source intact.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never commit real values
ANTHROPIC_API_KEY=

# Firebase target — the project ID is intentionally pinned so a migration or
# deployment cannot silently write to another Google Cloud project. App Hosting
# supplies Application Default Credentials; local development uses the Emulator
# Suite or GOOGLE_APPLICATION_CREDENTIALS outside this file.
FIREBASE_PROJECT_ID=law-clinic-finder
FIREBASE_DATABASE_ID=primary-eu
FIREBASE_STORAGE_BUCKET=law-clinic-finder.firebasestorage.app
IDENTITY_PLATFORM_API_KEY=

# Provider-neutral SMTP configuration. Brevo is the initial provider, but no
# provider-specific API is used. Port 465 uses implicit TLS; all other ports
# require STARTTLS. Keep the password server-only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Law Clinics Deutschland

# Public base URL of this deployment — used to build the /auth/confirm link in
# auth emails. PLACEHOLDER: replace before going live. During migration it must
# remain reachable for sent links; Firebase requires the hostname in
# Authentication > Settings > Authorized domains.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example

# Temporary App Hosting staging gate. Leave disabled for local development and
# remove all three variables when the public launch is approved. When enabled,
# use a unique 20+ character printable ASCII password stored only as a secret.
STAGING_ACCESS_ENABLED=false
STAGING_ACCESS_USERNAME=preview
STAGING_ACCESS_PASSWORD=

# Dev-only: enables the no-email test logins on /login. NEVER set in production.
DEV_LOGIN_ENABLED=

# Google Analytics 4 (optional). Set the measurement id to enable consent-gated
# tracking. The dashboard's GA cards (Nutzer/Sitzungen/Engagement) stay empty
# until the GA Data API is configured too: a GA4 property id and a service
# account JSON (see src/lib/analytics/ga-metrics.ts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
