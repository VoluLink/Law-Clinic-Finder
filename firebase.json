{
  "firestore": [
    {
      "database": "primary-eu",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "auth",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "apphosting": {
    "backendId": "web",
    "rootDir": ".",
    "alwaysDeployFromSource": true,
    "ignore": [
      ".git",
      ".firebase",
      ".next",
      "node_modules",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      ".codex",
      ".claude",
      "AGENTS.md",
      "CLAUDE.md",
      "sync-agent-config.sh",
      "docs",
      "e2e",
      "playwright.config.ts",
      "functions",
      "scripts",
      "**/*.test.*",
      "**/*.spec.*",
      "*-debug.log",
      "firebase-debug.log"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
