# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production
/build
/functions/lib

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# env files — real values never committed; the placeholder template is tracked
.env*
!.env.example

# vercel
.vercel

# Supabase CLI connection and version cache
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only assistant configuration and working notes. These were excluded via
# .git/info/exclude, which is not shared — on a fresh clone they would be
# committable again. Keeping them here makes the exclusion travel with the repo
# without publishing any of their contents.
.claude/
.codex/
CLAUDE.md
AGENTS.md
sync-agent-config.sh
PLAN.md
LOCAL-TESTING.md
WHICH-COPY.md

# Unpublished security assessment; tracked deliberately nowhere.
docs/security-hardening-plan.md
